# Copy this file to .env.local and fill in real values.
# Never commit .env.local. Only .env.example (no real values) goes in git.

# Supabase: Project Settings -> API. The publishable key is safe in the browser
# ONLY because Row Level Security is on for every table (see supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public URL of the app, used for magic-link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis (free tier) for rate limiting. Required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (free tier) for error tracking. Optional locally, strongly recommended in production.
NEXT_PUBLIC_SENTRY_DSN=
